{
  "version": "2.0",
  "name": "novel-pipeline-subagents",
  "description": "长篇小说工业化流水线核心专家子智能体规格清单。模型不再写死在规格/预设里：tier(flash/pro) 是唯一跨宿主抽象，具体模型名只存在于 host_profiles.<host> 中，由各宿主对等提供，运行时按『感知宿主 -> 角色 -> 模型』解析。",
  "subagents": [
    {
      "name": "novel_context_scout",
      "role": "前情探索与状态对齐总账员",
      "node_id": "explore_context",
      "spec_file": "context_scout.yaml",
      "default_tier": "flash",
      "tools": {
        "enable_write_tools": true,
        "enable_mcp_tools": false,
        "enable_subagent_tools": false
      }
    },
    {
      "name": "novel_chapter_writer",
      "role": "长篇小说主笔作家",
      "node_id": "draft_chapter",
      "spec_file": "chapter_writer.yaml",
      "default_tier": "flash",
      "tools": {
        "enable_write_tools": true,
        "enable_mcp_tools": false,
        "enable_subagent_tools": false
      }
    },
    {
      "name": "novel_deai_polisher",
      "role": "去AI味与文风校准专家",
      "node_id": "deai_polish",
      "spec_file": "deai_polisher.yaml",
      "default_tier": "flash",
      "tools": {
        "enable_write_tools": true,
        "enable_mcp_tools": false,
        "enable_subagent_tools": false
      }
    },
    {
      "name": "novel_qc_reviewer",
      "role": "历史考据主编与反吃书盲审员",
      "node_id": "review_qc",
      "spec_file": "qc_reviewer.yaml",
      "default_tier": "pro",
      "tools": {
        "enable_write_tools": true,
        "enable_mcp_tools": false,
        "enable_subagent_tools": false
      }
    },
    {
      "name": "novel_persona_auditor",
      "role": "角色人设与行为边界稽查官",
      "node_id": "audit_persona",
      "spec_file": "persona_auditor.yaml",
      "default_tier": "flash",
      "tools": {
        "enable_write_tools": true,
        "enable_mcp_tools": false,
        "enable_subagent_tools": false
      }
    },
    {
      "name": "novel_dungeon_architect",
      "role": "副本物理法则与生存机制架构师",
      "node_id": "dungeon_physics",
      "spec_file": "dungeon_architect.yaml",
      "default_tier": "pro",
      "tools": {
        "enable_write_tools": true,
        "enable_mcp_tools": false,
        "enable_subagent_tools": false
      }
    },
    {
      "name": "novel_faction_schemer",
      "role": "多方势力博弈与阴谋精算师",
      "node_id": "faction_agenda_matrix",
      "spec_file": "faction_schemer.yaml",
      "default_tier": "pro",
      "tools": {
        "enable_write_tools": true,
        "enable_mcp_tools": false,
        "enable_subagent_tools": false
      }
    }
  ],
  "presets": {
    "recommended": {
      "name": "黄金协同推荐配置 (4 Flash + 3 Pro)",
      "description": "前情/起草/润色/人设由高速 Flash 档快速生成，盲审/副本/权谋三道深度门禁由 Pro 档对抗挑刺。预设只声明 tier，具体模型由所在宿主的 host_profiles 决定。",
      "bindings": {
        "explore_context": { "tier": "flash" },
        "draft_chapter": { "tier": "flash" },
        "deai_polish": { "tier": "flash" },
        "audit_persona": { "tier": "flash" },
        "review_qc": { "tier": "pro" },
        "dungeon_physics": { "tier": "pro" },
        "faction_agenda_matrix": { "tier": "pro" }
      }
    },
    "all_flash": {
      "name": "极速省额度配置 (全 Flash)",
      "description": "全节点采用 Flash 档，速度最快、消耗最省，适合日常批量快速出稿。",
      "bindings": {
        "explore_context": { "tier": "flash" },
        "draft_chapter": { "tier": "flash" },
        "deai_polish": { "tier": "flash" },
        "audit_persona": { "tier": "flash" },
        "review_qc": { "tier": "flash" },
        "dungeon_physics": { "tier": "flash" },
        "faction_agenda_matrix": { "tier": "flash" }
      }
    },
    "all_pro": {
      "name": "全线深度打磨配置 (全 Pro)",
      "description": "全节点采用 Pro 档深度思考，推演最缜密、文笔最厚重，适合冲刺高潮卷。",
      "bindings": {
        "explore_context": { "tier": "pro" },
        "draft_chapter": { "tier": "pro" },
        "deai_polish": { "tier": "pro" },
        "audit_persona": { "tier": "pro" },
        "review_qc": { "tier": "pro" },
        "dungeon_physics": { "tier": "pro" },
        "faction_agenda_matrix": { "tier": "pro" }
      }
    },
    "writer_pro": {
      "name": "主笔深度配置 (正文 Pro + 其他 Flash)",
      "description": "正文撰写采用 Pro 档深度打磨文学叙事与博弈张力，前情、润色与审查均采用 Flash 档高速响应。",
      "bindings": {
        "explore_context": { "tier": "flash" },
        "draft_chapter": { "tier": "pro" },
        "deai_polish": { "tier": "flash" },
        "audit_persona": { "tier": "flash" },
        "review_qc": { "tier": "flash" },
        "dungeon_physics": { "tier": "flash" },
        "faction_agenda_matrix": { "tier": "flash" }
      }
    }
  },
  "host_profiles": {
    "qoder": {
      "description": "Qoder CLI 宿主。model 只认两类值：内置系统 ID（qfmodel=Qwen3.8-Flash、qmodel_38max=Qwen3.8-Max、gfmodel=GLM-5.3-Flash、gmodel=GLM-5.3、dmodel=DeepSeek-V4-Pro、dfmodel=DeepSeek-V4-Flash、mmodel=MiniMax-M3、cmodel=Cantus、kmodel=Kimi-K2.7-Code）与 BYOK 裸 UUID（形如 e1584866-30e7-461c-a2aa-4c9a039a2a2b=kimi-k3-cp，不带 byok: 前缀）。上游 slug（kimi-k3 / gemini-* / claude-*）不报错但静默回落到会话当前模型，2026-09-22 已实测复现。",
      "tiers": {
        "flash": ["qfmodel"],
        "flash_lite": ["qfmodel"],
        "pro": ["qmodel_38max"],
        "inherit": ["inherit"]
      },
      "role_models": {
        "novel_context_scout": "qfmodel",
        "novel_chapter_writer": "qfmodel",
        "novel_deai_polisher": "qmodel_38max",
        "novel_persona_auditor": "qmodel_38max",
        "novel_qc_reviewer": "qmodel_38max",
        "novel_dungeon_architect": "qmodel_38max",
        "novel_faction_schemer": "qmodel_38max"
      },
      "registration": {
        "mechanism": "host-agent-writes-definition-files",
        "agent_dir": ".qoder/agents/",
        "file_pattern": "{name}.md",
        "frontmatter_fields": ["name", "description", "model", "tools"],
        "model_field": "model",
        "body": "yaml 规格的 system_prompt 原文",
        "dispatch_tool": "Agent(subagent_type=<name>)",
        "dispatch_note": "模型由定义文件 frontmatter 的 model 决定，Qoder 不支持按调用覆盖；新增或改名的 agent 类型必须新开会话才注册得上",
        "performed_by": "宿主 agent（不是本仓库代码）",
        "requires_new_session": true,
        "per_call_model_override": false,
        "verify_with": "~/.qoder/projects/<项目slug>/<会话id>/subagents/task-*.json 的 resolvedModel 字段"
      }
    },
    "antigravity": {
      "description": "Google Antigravity 宿主。与 qoder 对等：同样通过 role_models/tiers 提供本宿主真实模型名，不再是全局默认。支持按调用传档位。",
      "tiers": {
        "flash": ["gemini-3.8-flash-high", "gemini-3.8-flash-medium", "gemini-2.5-flash"],
        "flash_lite": ["gemini-2.5-flash-lite"],
        "pro": ["gemini-3.1-pro-high", "claude-sonnet-4-6", "claude-opus-4.6-thinking"],
        "inherit": ["inherit"]
      },
      "role_models": {
        "novel_context_scout": "gemini-3.8-flash-high",
        "novel_chapter_writer": "gemini-3.1-pro-high",
        "novel_deai_polisher": "gemini-3.8-flash-high",
        "novel_persona_auditor": "gemini-3.8-flash-high",
        "novel_qc_reviewer": "gemini-3.8-flash-high",
        "novel_dungeon_architect": "gemini-3.8-flash-high",
        "novel_faction_schemer": "gemini-3.8-flash-high"
      },
      "registration": {
        "mechanism": "host-writes-md-frontmatter-files",
        "agent_dir": ".agents/agents/",
        "file_pattern": "{name}.md",
        "frontmatter_fields": ["name", "description", "tools", "subagent", "mainAgent", "model", "commandExecutionPolicy"],
        "model_field": "model（官方文档仅档位: inherit|flash|pro；具体 slug 走 invoke_subagent 按调用指定或 CLI --model）",
        "frontmatter_tier_map": {
          "gemini-3.8-flash-high": "flash",
          "gemini-3.8-flash-medium": "flash",
          "gemini-3.1-pro-high": "pro",
          "claude-sonnet-4-6": "pro",
          "claude-opus-4.6-thinking": "pro"
        },
        "dispatch_tool": "invoke_subagent",
        "dispatch_note": "支持按调用传模型；headless CLI 对未知 slug 直接报错退出（不静默回落）。agent 文件的发现时机未实测，注册后建议先核对 agy agents 列表",
        "performed_by": "宿主 agent（读取 get_registration_definitions() 的返回逐个写 .md 文件；SDK 路线为 types.SubagentConfig）",
        "requires_new_session": false,
        "per_call_model_override": true,
        "verify_with": "宿主自身的调度留痕；agy models 可列合法 slug（2026-09-22 经 context7 官方文档核对）"
      }
    },
    "generic": {
      "description": "未知宿主兜底：不提供任何模型映射。解析结果为『未配置』，提示宿主 Agent 先在 host_profiles 里为本宿主补 role_models/tiers，而不是回落到某个具体宿主的模型名。",
      "tiers": {},
      "role_models": {}
    }
  }
}
